<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef>
    <defName>RimLLM_Notebook</defName>
    <label>Diary</label>
    <description>A diary waiting for someone to tell the colony's story. Select a colonist and right-click it to pick it up. It stays in their inventory even when they are downed. Drop it from their Gear tab to pass it to someone else.</description>
    <thingClass>RimLLM.Notebook</thingClass>
    <category>Item</category>
    <selectable>true</selectable>
    <altitudeLayer>Item</altitudeLayer>
    <useHitPoints>false</useHitPoints>
    <destroyable>false</destroyable>
    <alwaysHaulable>true</alwaysHaulable>
    <stackLimit>1</stackLimit>
    <tradeability>None</tradeability>
    <graphicData>
      <texPath>diary</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.8</drawSize>
    </graphicData>
    <statBases>
      <Mass>0.1</Mass>
      <MarketValue>0</MarketValue>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>Items</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Forbiddable" />
    </comps>
  </ThingDef>
</Defs>
